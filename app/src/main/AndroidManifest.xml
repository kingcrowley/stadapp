<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Reading the paired tag, and a short buzz to confirm a tap. Both normal permissions. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Stad can't lock without NFC, so Play only offers it to phones that have it. -->
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="true" />

    <!--
        Package visibility (API 30+). Only what the block list needs; no QUERY_ALL_PACKAGES.
        LAUNCHER lists pickable apps; HOME, DIAL, SENDTO, SETTINGS and InputMethod find the apps
        that can never be blocked.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.view.InputMethod" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Stad"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Stad">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shown over a blocked app. Started only by the service below, never by other apps. -->
        <activity
            android:name=".service.BlockedActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="cc.stadapp.stad.blocked"
            android:theme="@style/Theme.Stad" />

        <!--
            Started by Android when a Stad tag is tapped anywhere. Invisible: it toggles the lock
            and closes. The filter must match the tag's first record (core/StadTagMime), including
            the DEFAULT category, or Android opens MainActivity without the tag instead. A MIME
            record, not a web link: Android 16+ sends http(s) tags to ACTION_VIEW instead.
            Exported by necessity; see TagActivity.
            TODO(target-sdk-37): Android 17 requires android:permission=
            "android.permission.DISPATCH_NFC_MESSAGE" here once targetSdk is 37 or higher.
        -->
        <activity
            android:name=".service.TagActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="standard"
            android:taskAffinity=""
            android:theme="@style/Theme.Stad.Invisible">
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.cc.stadapp.stad" />
            </intent-filter>
        </activity>

        <!--
            Detects when a blocked app comes to the front. Window-state changes only, no window
            content: see res/xml/blocker_accessibility_service.xml and docs/06_PLAY_POLICY.md.
        -->
        <service
            android:name=".service.BlockerAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/blocker_accessibility_service" />
        </service>
    </application>

</manifest>
